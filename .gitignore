# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
coverage/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# The price and trust models ship with the code: under 1 MB each, deterministic, and pinned by
# models/manifest.json (version + sha256 + git sha). That makes a deploy "start the server"
# rather than "retrain and hope", and rollback a git revert.
# Everything below is either large, or derived from user data.
ai-service/models/ranker.pkl
ai-service/models/ranker_meta.json
ai-service/models/*.joblib
ai-service/models/*.gguf
ai-service/data/*.csv
ai-service/data/raw/

# Archives
*.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
