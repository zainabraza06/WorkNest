<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: lets the emulator reach a local API over plain HTTP, for example
         API_URL=http://10.0.2.2:5000 passed as a dart-define. Release builds keep the platform
         default, which refuses cleartext traffic. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
