# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas) ───────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/worknest?retryWrites=true&w=majority

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Cloudinary (profile photos, ID docs, portfolio) ────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Stripe (TEST MODE ONLY — keys start with sk_test_) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=pkr

# ── AI microservice (FastAPI) ───────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=4000
