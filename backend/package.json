{
  "name": "worknest-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WorkNest core API \u2014 Express, MongoDB, JWT auth, Socket.io",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "export:ranking": "node --env-file-if-exists=.env src/scripts/exportRankingData.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "morgan": "^1.12.1",
    "multer": "^2.3.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
